# Copy this file to ".env" (same folder) and fill in your real values.
# Never share your real .env file or commit it to any public place —
# anyone with these values could send messages using your Twilio account.

TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
